# Get this from https://dashboard.composio.dev/settings
COMPOSIO_API_KEY=

# Only change this if you want per-account isolation (e.g. multiple brands).
# Everything in this repo defaults to a single user bucket.
COMPOSIO_USER_ID=default

# Needed by scripts/lab-watcher.mjs to read commits/releases from repos you
# point it at in config/lab-watch.json. A classic PAT with public_repo (or
# repo, for private repos) scope is enough — it only reads.
GITHUB_TOKEN=
